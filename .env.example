# Local stack configuration. `make up` copies this to .env if you have none,
# so the defaults below are what an untouched checkout runs with.
#
# Nothing here is a production value and nothing here is a secret. The one key
# is anvil's first published test account -- it is printed by anvil on every
# start, it is in every Foundry tutorial, and it controls nothing outside a
# local chain. A real deployment supplies KEEPER_PRIVATE_KEY from a secret
# store; see docs/deploy/services.md.

# ── chain ────────────────────────────────────────────────────────────────
# 31337 is the local anvil chain. Point the stack at Arc testnet by setting
# CHAIN_ID and RPC_URL, and by removing the anvil and deployer services.
CHAIN_ID=31337
RPC_URL=http://anvil:8545
ANVIL_BLOCK_TIME=2
ANVIL_PORT=8545

# ── database ─────────────────────────────────────────────────────────────
POSTGRES_USER=square
POSTGRES_PASSWORD=square
POSTGRES_DB=square
POSTGRES_PORT=5432
DATABASE_URL=postgres://square:square@postgres:5432/square

# ── keeper ───────────────────────────────────────────────────────────────
# anvil account 0, which DeployLocal also uses as the deployer and owner.
# gitleaks knows this exact value and allows it; any other key in this file
# is still reported.
KEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
MAX_PENDING_AGE_SECONDS=600

# ── ports on the host ────────────────────────────────────────────────────
PROVER_PORT=3003
INDEXER_PORT=3010
KEEPER_PORT=3011
APP_PORT=3000

# ── indexer ──────────────────────────────────────────────────────────────
START_BLOCK=0
POLL_INTERVAL_MS=1000

# ── application ──────────────────────────────────────────────────────────
# Read by a browser on the host, so these are published ports, not service
# names on the compose network.
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_INDEXER_URL=http://localhost:3010

SQUARE_VERSION=0.1.0
