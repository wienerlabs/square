{
  "name": "@squaresdk/mcp",
  "version": "0.1.0",
  "description": "MCP in both directions: a pooled, idle-timed client so a Square agent can call tools on MCP servers, and a Square MCP server so Claude Desktop or Cursor can look an agent up by its did:aip and give it a paid job through SquareJob escrow.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "square-mcp": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:anvil": "ANVIL=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@squaresdk/a2a": "file:../a2a",
    "@squaresdk/agent": "file:../agent",
    "@squaresdk/core": "file:../core",
    "@squaresdk/did-resolver": "file:../did-resolver",
    "@squaresdk/x402": "file:../x402",
    "viem": "^2.48.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.0",
    "@types/node": "^22.20.1",
    "@x402/core": "2.25.0",
    "hono": "^4.7.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
