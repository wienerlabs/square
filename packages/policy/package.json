{
  "name": "@squaresdk/policy",
  "version": "0.1.0",
  "description": "The institution's side of the compliance gate: commit a spending policy to PolicyRegistry, ask the prover for a proof that a release fits it, keep the proof bound to each job current as the payee, the net and the day's counter move, and release.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:anvil": "ANVIL=1 vitest run",
    "typecheck": "tsc --noEmit",
    "install-module": "node scripts/install-module-for-this-build.mjs"
  },
  "dependencies": {
    "@squaresdk/core": "file:../core",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.5",
    "viem": "^2.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
